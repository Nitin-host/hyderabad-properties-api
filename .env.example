# Server
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend.up.railway.app

# MongoDB (Atlas recommended on Railway)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/hyderabad-properties

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Video: API should not encode. Run Dockerfile.video as a second service.
VIDEO_PROCESS_IN_API=false
VIDEO_WORKER_SECRET=
VIDEO_WORKER_POLL_MS=4000
# Handshake URLs. docker compose sets these automatically.
# Local npm: leave empty. Railway: use private service URLs.
VIDEO_WORKER_URL=
API_URL=

# Email (Brevo)
BREVO_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=RR Properties
SUPER_ADMIN_EMAIL=

# Optional SMTP leftovers
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=